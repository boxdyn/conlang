(* Conlang Expression Grammar *)


Start = SOI Expr? EOI ;

(* Expressions *)

Expr = InAttr Expr | ExprDo ;
(* Not pictured: semicolon elision after block exprs *)
ExprDo = (ExprBody? ';')+ ExprBody? | ExprBody ;
ExprBody = ExprAssign ;
ExprAssign = ExprMake (AssignOp ExprMake)* ;
AssignOp = (
    '<<=' | '>>=' | '*=' | '/='
  | '%='  | '+='  | '-=' | '&='
  | '^='  | '|='  | '='
);
(* Hack: grammar is context-sensitive. Parser uses look-behind to disambiguate *)
ExprMake = !(Path '{') ExprTuple | Path '{' (MakeArm ',')* MakeArm? '}' ;
MakeArm = Identifier (':' ExprLogical)? ;

ExprTuple = ExprLogical (',' ExprLogical)* ;
ExprLogical = ExprLogOr ('^^' ExprLogOr)* ;
ExprLogOr = ExprLogAnd ('||' ExprLogAnd)* ;
ExprLogAnd = ExprCompare ('&&' ExprCompare)* ;
ExprCompare = ExprRange (('<=' | '!=' | '==' | '>=' | '<' | '>') ExprRange)* ;
ExprRange = (
    ExprBinary? ('..' | '..=') ExprBinary?
  | ExprBinary
);
ExprBinary = ExprShift (('&' | '|' | '^') ExprShift)* ;
ExprShift = ExprFactor (('<<' | '>>') ExprFactor)? ;
ExprFactor = ExprTerm (('+' | '-') ExprTerm)* ;
ExprTerm = ExprCast (('*' | '/' | '%') ExprCast)* ;
ExprCast = ExprUnary ("as" ExprProject)* ;
ExprUnary = (
    ('&' | '&&') ExprUnary      (* Ref, DoubleRef *)
  | ('!' | '!!') ExprUnary      (* Not, Identity *)
  | ('-' | '+' | '*') ExprUnary (* Neg, Identity, Deref *)
  | ExprProject
);
(* hack: Pest, which I'm validating this with, doesn't know '..' is better than '.' *)
ExprProject = ExprExtend (!'..' '.' ExprExtend | '[' Expr? ']')* ;
ExprExtend = ExprMax ('(' Expr? ')')* ;

ExprMax = (
    "do" Expr
  | ("pub" | "const" | "static") ExprMax
  | ("loop" | "defer" | "break" | "return") ExprBody
  | ("if" | "while") ExprLogical ExprBody ("else" ExprBody)?
  | "continue"
  | '`' Expr? '`'
  | '{' Expr? '}'
  | '(' Expr? ')'
  | '[' ExprTuple? ']'
  | '[' ExprTuple (';' ExprTuple)? ']'
  | "use" Use
  | '$' Token
  | '...'
  | OutAttr ExprMax
  | InAttr Expr (* FIXME: move this *)
  | Match
  | Bind
  | Literal
  | Path
);

Match = "match" ExprTuple '{' (MatchArm ';')* MatchArm? '}' ;
MatchArm = Pat '=>' ExprBody ;

Bind = BindLet | BindType | BindStruct | BindEnum | BindFn | BindMod | BindImpl | BindFor ;
BindLet    = "let"    PatTuple ('=' ExprBody   ("else" ExprBody)?)? ;
BindType   = "type"   PatAlt   ('=' ExprBody)? ;
BindStruct = "struct" PatTuple ;
BindEnum   = "enum"   PatTuple ;
BindFn     = "fn"     PatFn    ('='? ExprBody) ;
BindMod    = "mod"    PatMax   ('='? ExprBody) ;
BindImpl   = "impl"   PatFn    ('='? ExprBody) ;
BindFor    = "for"    PatTuple "in" ExprLogical ExprBody ("else" ExprBody)? ;

(* Patterns *)

Pat = PatAlt ;
PatAlt = '|'? PatTuple ('|' PatTuple)* ;
PatTuple = PatTyped (',' PatTyped)* ;
PatTyped = Attr? (
    '{' (PatTyped ',')* PatTyped? '}'
  | PatFn '{' (PatTyped ',')* PatTyped? '}'
  | PatFn ':' PatTyped
  | PatFn
) PatGuard? ;
PatGuard = "if" ExprLogical ;

PatFn = (
    PatParams
  | "fn" PatFn
  | '&' PatFn
  | '&&' PatFn
  | PatGenerics PatFn
  | PatRange PatGenerics* PatParams? ('->' PatFn)?
);
PatGenerics = '<' PatTuple? '>' ;
PatParams   = '(' PatTuple? ')' ;

PatRange = (
    PatMax? '..' PatMax?
  | PatMax? '..=' PatMax?
  | PatMax
);
PatMax = (
    '[' PatTuple (';' PatTuple)? ']' (* Slices and Arrays*)
  | "pub" PatMax                     (* Publicity  *)
  | "mut" PatMax                     (* Mutability *)
  | '*' PatMax                       (* Ptr *)
  | '$' Token                        (* Metaidentifier *)
  | '!'                              (* Never *)
  | '_'                              (* Wildcard *)
  | Identifier                       (* Binding wildcard *)
  | PatConst                         (* Constant expression *)
);
PatConst = (
    "const" Expr
  | '-' Expr
  | Literal
  | Path
);

(* Other AST nodes *)

Attr = InAttr | OutAttr ;
InAttr = '#!' '[' Expr ']' | InDoc;
OutAttr = '#' '[' Expr ']' | OutDoc;

Path = '::'? Identifier ('::' Identifier)* ;

Literal = (
    "true" | "false"
  | Character
  | Integer
  | String
);

Use = (
    '*'                        (* Glob *)
  | '{' (Use ',')* Use? '}'    (* Tree *)
  | Identifier '::' Use        (* Path *)
  | Identifier "as" Identifier (* Alias *)
  | Identifier                 (* Name *)
);
